          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas un fichier texte ; comparaison impossible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è un file di testo; impossibile confrontarlo."
          }
        }
