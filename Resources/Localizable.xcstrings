    "%@ is not a text file; it cannot be compared.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bir metin dosyası değil; karşılaştırılamıyor."
